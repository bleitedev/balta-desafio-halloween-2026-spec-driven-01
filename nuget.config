<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Remove todas as fontes globais herdadas da máquina -->
    <clear />
    <!-- Mantém apenas a fonte oficial do NuGet -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>